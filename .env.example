# Copy this file to .env.local for both the Vite app and local sync scripts.

# Cloudflare R2 write credentials. Never use a VITE_ prefix for secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maimai-jackets

# Public jacket Worker URL. Match GitHub's R2_PUBLIC_URL Actions variable.
VITE_JACKET_BASE_URL=https://your-jacket-worker.example.workers.dev

# Public Apps Script /exec endpoint that returns { scores: [...] }.
SCORES_API_URL=

# Optional; these defaults point to SEGA's public catalog and jacket directory.
SEGA_CATALOG_URL=https://maimai.sega.jp/data/maimai_songs.json
SEGA_JACKET_BASE_URL=https://maimaidx.jp/maimai-mobile/img/Music/
