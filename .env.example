# Copy this file to .env.local for both the Vite app and local sync scripts.

# Cloudflare R2 write credentials. Never use a VITE_ prefix for secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maimai-jackets

# Public jacket Worker URL. Match GitHub's R2_PUBLIC_URL Actions variable.
VITE_JACKET_BASE_URL=https://your-jacket-worker.example.workers.dev

# Google APIs used by the local image importer and score archiver.
# Keep the service-account JSON outside the repository and use an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=1RCYRAXt7gc-z8BBphIJmFL-vLHDtB3WY
GOOGLE_PROCESSED_FOLDER_ID=1v5PwEA5pqS9Poqgr5rwVaQbepAy-dYmc
GOOGLE_DUPLICATES_FOLDER_ID=1Rn5sSM1oUlLKYgm4tBjMGQOe7J2C76VZ
GOOGLE_SPREADSHEET_ID=1oRcco59vtzEzdCeX2ryXpMEMJtKICMoxKGpMWkgV-gA
GOOGLE_SHEET_NAME=MainInfo

# Required for local OCR imports. GitHub Actions uses the corresponding secret/variables.
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.5
SCORE_CAPTURE_TIME_ZONE=America/New_York

# Required catalog sources. Keep these aligned with the GitHub Actions variables.
SEGA_CATALOG_URL=https://maimai.sega.jp/data/maimai_songs.json
SEGA_JACKET_BASE_URL=https://maimaidx.jp/maimai-mobile/img/Music/
CHART_SUPPLEMENT_METADATA_URL=https://www.diving-fish.com/api/maimaidxprober/music_data
