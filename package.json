{
  "name": "maimai-score-gallery",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test test/**/*.test.mjs",
    "lint": "eslint .",
    "data:validate": "node scripts/validate-data.mjs",
    "google:check": "node --env-file-if-exists=.env.local scripts/check-google-access.mjs",
    "scores:check": "node --env-file-if-exists=.env.local scripts/check-score-sheet.mjs",
    "scores:import": "node --env-file-if-exists=.env.local scripts/import-images.mjs",
    "scores:sync": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/etc/ssl/cert.pem} node --env-file-if-exists=.env.local scripts/sync-scores.mjs",
    "catalog:sync": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/etc/ssl/cert.pem} node --env-file-if-exists=.env.local scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "latest",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "exifr": "^7.1.3",
    "globals": "latest",
    "googleapis": "^174.0.1",
    "heic-decode": "^2.1.0",
    "openai": "^7.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "latest",
    "typescript-eslint": "latest",
    "vite-plugin-pwa": "^1.3.0"
  }
}
